#!/usr/bin/env bash
# Pre-commit hook for repos using OpenSpec.
# If the staged diff touches openspec/changes/<id>/ (and that change is
# not yet archived under openspec/changes/archive/<id>/), run
# `openspec validate <id> --strict` against every id that is touched.
# Block the commit on any validation error.
#
# Install by pointing core.hooksPath at this directory:
#   git config core.hooksPath scripts/hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Collect unique change ids touched by the staged diff, excluding
# anything under openspec/changes/archive/.
IDS=""
while IFS= read -r path; do
  case "$path" in
    openspec/changes/archive/*) continue ;;
    openspec/changes/*/*)
      id=$(printf '%s\n' "$path" | awk -F/ '{print $3}')
      case " $IDS " in
        *" $id "*) ;;
        *) IDS="$IDS $id" ;;
      esac
      ;;
  esac
done <<EOF_IDS
$(git diff --cached --name-only --diff-filter=ACMR)
EOF_IDS

if [ -z "$IDS" ]; then
  exit 0
fi

if ! command -v openspec >/dev/null 2>&1; then
  printf 'pre-commit: "openspec" not found on PATH. Install with: npm i -g @fission-ai/openspec\n' >&2
  exit 1
fi

FAILED=0
for id in $IDS; do
  if [ -d "openspec/changes/$id" ]; then
    printf 'pre-commit: validating openspec change "%s"\n' "$id"
    if ! openspec validate "$id" --strict; then
      printf 'pre-commit: openspec validate "%s" FAILED\n' "$id" >&2
      FAILED=1
    fi
  fi
done

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi