#!/usr/bin/env bash
# Pre-push hook for repos using OpenSpec.
#
# Performs the same two checks as the pre-commit hook, but against
# the set of commits that would be pushed (i.e. local commits
# whose commits are not on origin/<remote-branch>). This is the
# second gate: even if a contributor bypasses pre-commit with
# --no-verify, the push is still rejected if the Kanban binding
# or the OpenSpec validation is broken.
#
# Why duplicate the checks? Because contributors can run `git commit
# --no-verify` (sometimes legitimately, e.g. amending an unrelated
# typo) and we still want the safety net at push time.
#
# Install by pointing core.hooksPath at this directory:
#   git config core.hooksPath scripts/hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

ACTIVE_BOARD="todo-demo"
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
BOARD_DB="$HERMES_HOME/kanban/boards/$ACTIVE_BOARD/kanban.db"

if ! command -v openspec >/dev/null 2>&1; then
  printf 'pre-push: "openspec" not found on PATH. Install with: npm i -g @fission-ai/openspec\n' >&2
  exit 1
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'pre-push: "sqlite3" not found on PATH. Install with: brew install sqlite3\n' >&2
  exit 1
fi

# Read the push target. Pre-push receives on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# We don't actually need them — git rev-parse below is enough.
while IFS=' ' read -r _local_ref _local_sha _remote_ref _remote_sha; do
  :
done

# Determine the upstream. `git rev-parse @{u}` returns the upstream
# of the current branch, or errors if there isn't one (first push).
UPSTREAM="$(git rev-parse --verify --quiet @{u} 2>/dev/null || true)"

if [ -z "$UPSTREAM" ]; then
  # First push of this branch: every local commit is in the diff.
  RANGE="--all"
else
  UPSTREAM_SHA="$(git rev-parse "$UPSTREAM")"
  RANGE="$UPSTREAM_SHA..HEAD"
fi

FAILED=0

# Collect every change id touched by any commit in the push range,
# excluding archive/.
IDS=""
while IFS= read -r commit; do
  while IFS= read -r path; do
    case "$path" in
      openspec/changes/archive/*) continue ;;
      openspec/changes/*/*)
        id=$(printf '%s\n' "$path" | awk -F/ '{print $3}')
        case " $IDS " in
          *" $id "*) ;;
          *) IDS="$IDS $id" ;;
        esac
        ;;
    esac
  done < <(git show --name-only --format='' "$commit" \
    | awk 'NF && $0 !~ /^commit/ && $0 !~ /^Author/ && $0 !~ /^Date/ && $0 !~ /^\s*$/')
done < <(git rev-list $RANGE 2>/dev/null)

# Was any code path touched by the push?
CODE_TOUCHED=0
while IFS= read -r commit; do
  while IFS= read -r path; do
    case "$path" in
      assets/*|index.html|tests/*) CODE_TOUCHED=1 ;;
    esac
  done < <(git show --name-only --format='' "$commit")
done < <(git rev-list $RANGE 2>/dev/null)

for id in $IDS; do
  if [ -d "openspec/changes/$id" ]; then
    printf 'pre-push: [openspec] validating change "%s"\n' "$id"
    if ! openspec validate "$id" --strict; then
      printf 'pre-push: [openspec] validate "%s" FAILED\n' "$id" >&2
      FAILED=1
    fi
  fi
done

if [ "$CODE_TOUCHED" -eq 1 ]; then
  if [ ! -f "$BOARD_DB" ]; then
    printf 'pre-push: [kanban] board DB not found at %s\n' "$BOARD_DB" >&2
    FAILED=1
  else
    while IFS='|' read -r status key; do
      [ -z "$status" ] && continue
      case "$status" in
        done|archived|cancelled) continue ;;
      esac

      if [ -z "$key" ] || [ "$key" = "" ]; then
        printf 'pre-push: [kanban] task on board "%s" has no idempotency_key. Re-create with: hermes kanban --board %s create --idempotency-key=<slug> "..."\n' \
          "$ACTIVE_BOARD" "$ACTIVE_BOARD" >&2
        FAILED=1
        continue
      fi

      if [ ! -d "openspec/changes/$key" ]; then
        printf 'pre-push: [kanban] task idempotency_key "%s" (status=%s) has no openspec change at openspec/changes/%s/.\n' \
          "$key" "$status" "$key" >&2
        FAILED=1
        continue
      fi

      printf 'pre-push: [kanban] validating openspec change for task "%s"\n' "$key"
      if ! openspec validate "$key" --strict; then
        printf 'pre-push: [kanban] validate "%s" FAILED\n' "$key" >&2
        FAILED=1
      fi
    done < <(sqlite3 -separator '|' "$BOARD_DB" \
      "SELECT status, idempotency_key FROM tasks WHERE idempotency_key IS NOT NULL AND idempotency_key != '';" 2>/dev/null)
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  printf 'pre-push: blocked. Fix the errors above (or move the task to done/archived/cancelled) and try again.\n' >&2
  exit 1
fi